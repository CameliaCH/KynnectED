# Copy to .env only if no .env exists. Keep real credentials out of Git.
# These four values are required for recording uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: leave empty to derive the standard endpoint from R2_ACCOUNT_ID.
R2_ENDPOINT=
FFPROBE_BIN=ffprobe

# On the HTTPS production server, set this to 1 and set the site's origin.
KYNNECTED_HTTPS=0
KYNNECTED_PUBLIC_URL=http://localhost:5001

# Generate the private key on the server with: flask --app app setup-push
KYNNECTED_PUSH_ENABLED=1
KYNNECTED_PUSH_BACKGROUND_WORKER=1
KYNNECTED_PUSH_SUBJECT=mailto:kynnected.org@gmail.com
# Optional: default is instance/push-private.pem in this checkout.
# KYNNECTED_PUSH_PRIVATE_KEY_FILE=/absolute/persistent/path/push-private.pem
